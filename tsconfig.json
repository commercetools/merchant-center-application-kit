{
  "extends": "@commercetools-frontend/application-config/tsconfig-mc-app.json",
  "compilerOptions": {
    "typeRoots": ["@types", "@types-extensions", "node_modules/@types"],
    "skipLibCheck": true,
    // Allow tsc to resolve dependencies of `@types` packages in the way pnpm sets up the `node_modules`.
    "preserveSymlinks": false,
    // Stories are colocated in `packages/*`, which are published and must not
    // depend on the private `storybook` workspace. Mirrors the Vite alias in
    // `storybook/.storybook/main.ts`.
    "paths": {
      "@/storybook-helpers": ["./storybook/src/helpers"],
      // Colocated stories import `Meta`/`StoryObj` as types only, so nothing
      // resolves this at runtime — but tsc and eslint still have to, and pnpm
      // keeps the package in the `storybook` workspace where it's declared.
      "@storybook/react-vite": [
        "./storybook/node_modules/@storybook/react-vite"
      ]
    }
  },
  "include": [
    "packages",
    "packages-backend",
    "storybook",
    "visual-testing-app",
    "website-components-playground"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.visualspec.ts",
    "**/test/**",
    "packages/application-components/src/components/dialogs/internals/dialog-test-utils.tsx"
  ],
  // Old "moduleResolution": "Node" option required for Cypress
  // https://github.com/cypress-io/cypress/issues/26308#issuecomment-1663592648
  //
  // TODO: Remove when upgrading Cypress to > v12.
  "ts-node": {
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "nodenext"
    }
  }
}
